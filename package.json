{
    "author": "Austin Cheney",
    "bin": "./bin/aphorio.js",
    "bugs": {
        "url": "https://github.com/prettydiff/aphorio/issues"
    },
    "command": "share",
    "cspell": {
        "dictionaryDefinitions": [
            {
                "name": "custom-words",
                "path": "./.words",
                "addWords": true
            }
        ],
        "dictionaries": ["custom-words"],
        "ignorePaths": ["node_modules", "./.words"]
    },
    "description": "WebSocket first web server, HTTP over WebSockets.",
    "dependencies": {
        "@lydell/node-pty": "1.2.0-beta.15",
        "@xterm/xterm": "^6.0.0",
        "chart.js": "^4.5.1",
        "jschardet": "^3.1.4"
    },
    "devDependencies": {
        "@types/node": "^25.0.8",
        "typescript": "^6.0.3"
    },
    "directories": {
        "bin": "./bin",
        "lib": "./lib"
    },
    "keywords": [],
    "license": "AGPL-3.0-only",
    "main": "lib/index.ts",
    "name": "aphorio",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/prettydiff/aphorio.git"
    },
    "scripts": {
        "server-bun": "bun ./lib/index.ts",
        "server-node": "node ./lib/index.ts",
        "test-bun":   "bun ./lib/index.ts test",
        "test-node":   "node ./lib/index.ts test",
        "tsc":    "node ./node_modules/typescript/bin/tsc --pretty"
    },
    "types": "/lib/typescript",
    "type": "module",
    "version": "0.6.2"
}
